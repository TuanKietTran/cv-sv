# Canonical external origin. Required in production; HTTPS and no trailing path.
# NUXT_ADMIN_ORIGIN=https://admin.example.com

# GitHub OAuth app (https://github.com/settings/developers → New OAuth App)
# Callback URL: http://localhost:3001/oauth/github (or NUXT_ADMIN_ORIGIN + /oauth/github)
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
# Optional explicit override; when set it must exactly match NUXT_ADMIN_ORIGIN + /oauth/github.
# NUXT_GITHUB_REDIRECT_URL=https://admin.example.com/oauth/github

# Numeric GitHub user ids allowed to sign in (ids are immutable, logins are not).
NUXT_GITHUB_ALLOWED_IDS=35926768

# At least 32 random characters; required outside `nuxt dev`.
NUXT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Must point at the same storage ruxt uses.
# CV_DATA_DIR=../.data/cv
# CV_PIPELINE_DATA_DIR=../.data/cv-pipeline
# ANALYTICS_DATA_DIR=../.data/analytics
