# Database (Neon serverless PostgreSQL — required for Deno Deploy)
# Get from: https://neon.tech → project → connection string (pooled)
DATABASE_URL=

# Force Node.js server preset for local Docker / on-prem builds
# Leave unset for Deno Deploy (default)
# NITRO_PRESET=node-server

# Authentication
# Create an application at https://dashboard.clerk.com and copy its development
# or production keys. The secret key is server-only.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
NUXT_CLERK_SECRET_KEY=sk_test_replace-me

# Retained for legacy email/password sessions during the Clerk migration.
SESSION_SECRET=replace-with-at-least-32-random-characters

# CV storage
# CV_DATA_DIR=./.data/cv
# CV_PIPELINE_DATA_DIR=./.data/cv-pipeline

# Server-side PDF/image import
# Run `pnpm cv:pipeline:setup` for the default local Python path.
# CV_PIPELINE_PYTHON=./.data/cv-pipeline-venv/bin/python
# CV_PIPELINE_DIR=./server/pipeline
# CV_IMPORT_MAX_BYTES=15728640
# CV_ARTIFACT_TTL_HOURS=24
